# Core Supabase Project URL (Public)
NEXT_PUBLIC_SUPABASE_URL=https://qghyfyktqibycanncbkk.supabase.co

# Core Supabase Anon / Publishable Key (Public - for client-side Auth & SSR)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Core Supabase Service Role / Secret Key (Private - Server only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Supabase Server SDK Standard Aliases (Optional for @supabase/server compat)
SUPABASE_URL=https://qghyfyktqibycanncbkk.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here
SUPABASE_SECRET_KEY=your_supabase_service_role_key_here

